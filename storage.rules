rules_version = '2';

// BIN TIME Cloud Storage Security Rules
// BT-014: 프로필 사진만 정의한다. 시간표 이미지(BT-025) 등은 담당 이슈에서 추가한다.
service firebase.storage {
  match /b/{bucket}/o {

    // profileImages/{uid}/profile.jpg — 로그인 사용자는 읽기, 본인만 5MB 미만 JPEG 쓰기.
    // 계약상 사용자당 사진 1장을 같은 경로에 덮어쓴다. 다른 파일명은 아래 규칙이 없으므로 기본 거부된다
    // (#79 리뷰 반영: 임의 파일명으로 저장량이 계속 늘어나는 것을 막음).
    match /profileImages/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
