{
  "name": "bintime-functions",
  "private": true,
  "description": "BIN TIME Cloud Functions (BT-024 Gemini 공통 게이트웨이)",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run --exclude emulator-tests/**",
    "test:emulator": "vitest run emulator-tests --testTimeout 30000 --hookTimeout 30000",
    "serve": "npm run build && firebase emulators:start --project demo-bintime --only auth,functions,firestore"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "firebase": "^13.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
