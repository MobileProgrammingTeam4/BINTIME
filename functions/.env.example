# functions/.env.local 로 복사해서 쓴다(.env.local 은 Git 제외). 비밀값은 여기 넣지 않는다.
# GEMINI_API_KEY 는 에뮬레이터에서 functions/.secret.local, 배포 시 `firebase functions:secrets:set GEMINI_API_KEY` 로만 둔다.

# mock: 키 없이 계약대로 응답(meta.mock=true). live: 실제 Gemini 호출.
# 비워 두면 에뮬레이터는 mock, 배포 환경은 live 로 동작한다.
AI_MODE=mock

# 실제 호출 모델 ID. AI Studio 모델 목록에서 확인한 값을 넣는다(계획: Gemini 3.5 Flash-Lite).
# live 모드에서 비어 있으면 AI_UNAVAILABLE 로 응답한다.
GEMINI_MODEL=

# 학교 이메일 허용 접미사(쉼표 구분, 대소문자 무시). 배포 값(.env.bintime-mobile)과 같게 둔다.
# 비어 있으면 모든 AI Callable 호출을 PERMISSION_DENIED 로 거부한다.
ALLOWED_EMAIL_SUFFIXES=.ac.kr,.edu
