<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BinTime" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/action_primary</item>
        <item name="colorOnPrimary">@color/bg_card</item>
        <item name="android:windowBackground">@color/bg_card</item>
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- 공통 컴포넌트 스타일 (Figma 빈틈 매칭/TabItem, Button) -->
    <style name="Widget.BinTime.Tab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_chip_filter</item>
        <item name="android:textColor">@color/chip_filter_text</item>
    </style>

    <style name="Widget.BinTime.ButtonPrimary" parent="">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bg_card</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.BinTime.ButtonOutline" parent="Widget.BinTime.ButtonPrimary">
        <item name="android:textColor">@color/action_primary</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
    </style>

    <style name="Widget.BinTime.PillPrimary" parent="Widget.BinTime.ButtonPrimary">
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_pill_primary</item>
    </style>

    <style name="Widget.BinTime.PillOutline" parent="Widget.BinTime.PillPrimary">
        <item name="android:textColor">@color/action_primary</item>
        <item name="android:background">@drawable/bg_pill_outline</item>
    </style>

    <style name="ShapeAppearance.BinTime.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.BinTime.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 공통 타이포 (Figma 02. Typography) -->
    <style name="TextAppearance.BinTime" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="TextAppearance.BinTime.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BinTime.H1">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BinTime.H2">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BinTime.H3">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BinTime.BodyL">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.BinTime.BodyM">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.BinTime.BodyS">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextAppearance.BinTime.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.BinTime.CaptionBold">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BinTime.ButtonL">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.BinTime.ButtonS">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
