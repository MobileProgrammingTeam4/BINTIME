<?xml version="1.0" encoding="utf-8"?>
<!-- 온보딩 (Figma 41:9992). 수치는 Figma MCP get_design_context 값 그대로.
     Figma 상태바(44)·홈 인디케이터(28) 영역은 실제 기기 시스템 바 여백(SystemBarInsets)으로 대체한다 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:fitsSystemWindows="true">

    <!-- 환영 콘텐츠: pt80 pb32 px32, 간격 32 -->
    <LinearLayout
        android:id="@+id/layoutCenterContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="80dp"
        android:paddingBottom="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgMascot"
            android:layout_width="300dp"
            android:layout_height="245dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/img_onboarding_mascot" />

        <!-- Display 28 Bold -->
        <TextView
            android:id="@+id/tvOnboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/onboarding_title"
            android:textAppearance="@style/TextAppearance.BinTime.Display" />

        <!-- Body L 16 Medium, 간격 16 -->
        <TextView
            android:id="@+id/tvOnboardingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/onboarding_subtitle"
            android:textAppearance="@style/TextAppearance.BinTime.BodyL"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- 주요 액션: pt16 pb12 px20, Button Primary h52 -->
    <FrameLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnStart"
            style="@style/Widget.BinTime.PillPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/onboarding_start_button" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
