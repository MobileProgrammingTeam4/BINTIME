<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 116:3395 매칭 후기 남기기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/reviewBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/review_back"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/review_write_header"
            android:textAppearance="@style/TextAppearance.BinTime.H1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/reviewForm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_write_title"
                        android:textAppearance="@style/TextAppearance.BinTime.H1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/review_write_subtitle"
                        android:textAppearance="@style/TextAppearance.BinTime.BodyS"
                        android:textColor="@color/text_secondary" />

                    <include
                        android:id="@+id/reviewPartner"
                        layout="@layout/view_partner_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <LinearLayout
                        android:id="@+id/reviewSatisfaction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/review_keywords_title"
                        android:textAppearance="@style/TextAppearance.BinTime.CaptionBold"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:id="@+id/reviewKeywords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/review_comment_title"
                        android:textAppearance="@style/TextAppearance.BinTime.CaptionBold"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/reviewComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card"
                        android:gravity="top|start"
                        android:hint="@string/review_comment_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="100"
                        android:minHeight="80dp"
                        android:padding="14dp"
                        android:textAppearance="@style/TextAppearance.BinTime.BodyS"
                        android:textColorHint="@color/text_tertiary" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/reviewNotMet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:textAppearance="@style/TextAppearance.BinTime.Caption"
                    android:textColor="@color/text_tertiary"
                    tools:text="김지민님과 만나지 못했나요?" />

                <TextView
                    android:id="@+id/reviewSubmit"
                    style="@style/Widget.BinTime.PillPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/review_submit" />
            </LinearLayout>
        </LinearLayout>

        <com.team4.bintime.common.StateView
            android:id="@+id/reviewState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
