<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_dialog">
                <TextView android:id="@+id/popupClose" android:layout_width="48dp" android:layout_height="40dp" android:layout_gravity="end" android:gravity="center" android:text="×" android:textSize="32sp" android:textColor="@color/text_tertiary" android:background="?attr/selectableItemBackground" android:contentDescription="@string/request_close" android:focusable="true" android:clickable="true"/>
                <com.google.android.material.imageview.ShapeableImageView xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/popupProfilePhoto" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:scaleType="centerCrop" android:src="@drawable/img_default_profile" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/ShapeAppearance.BinTime.Circle"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/notification_request_title" android:textAppearance="@style/TextAppearance.BinTime.H2"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:gravity="center" android:text="@string/notification_request_message" android:textAppearance="@style/TextAppearance.BinTime.BodyM" android:textColor="@color/text_secondary"/>
                <include android:id="@+id/summary" layout="@layout/view_match_summary"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/popupTags" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView android:id="@+id/popupIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.BinTime.BodyS" android:textColor="@color/text_secondary"/>
                <TextView android:id="@+id/popupQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="20dp" android:gravity="center" android:text="@string/notification_question" android:textAppearance="@style/TextAppearance.BinTime.BodyM"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/popupReject" style="@style/Widget.BinTime.ButtonOutline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="12dp" android:text="@string/request_reject"/>
                    <TextView android:id="@+id/popupAccept" style="@style/Widget.BinTime.ButtonPrimary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/request_accept"/>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.checkbox.MaterialCheckBox xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/popupToday" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center" android:text="@string/notification_today" android:textSize="12sp" android:textColor="@android:color/white" app:buttonTint="@color/popup_checkbox_tint" app:buttonIconTint="@color/bg_card" app:useMaterialThemeColors="false" android:drawablePadding="8dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
