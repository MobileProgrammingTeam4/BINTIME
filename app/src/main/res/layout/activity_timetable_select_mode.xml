<?xml version="1.0" encoding="utf-8"?>
<!-- 파일 위치: res/layout/activity_timetable_select_mode.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 상단 툴바 (뒤로가기 + 타이틀) -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="뒤로가기"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시간표 등록"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- 안내 문구 영역 -->
            <TextView
                android:id="@+id/tvSelectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간표를 어떻게 등록할까요?"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:text="원하는 방법을 선택해 주세요."
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- 옵션 1: 수동으로 입력하기 카드 -->
            <LinearLayout
                android:id="@+id/btnManualInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_select_mode_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- 원형 아이콘 배경 -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_circle_icon">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="수동 입력 아이콘"
                        android:src="@drawable/ic_mode_manual" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수동으로 입력하기"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="직접 시간표를 입력할 수 있어요."
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="12dp"
                    android:contentDescription="이동"
                    android:src="@drawable/ic_chevron_right_small"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- 옵션 2: 이미지로 업로드하기 카드 -->
            <LinearLayout
                android:id="@+id/btnImageUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_select_mode_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- 원형 아이콘 배경 -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_circle_icon">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="이미지 업로드 아이콘"
                        android:src="@drawable/ic_mode_image" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이미지로 업로드하기"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="시간표 이미지를 업로드하면\n자동으로 분석돼요."
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="12dp"
                    android:contentDescription="이동"
                    android:src="@drawable/ic_chevron_right_small"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- 하단 안내 문구 -->
            <TextView
                android:id="@+id/tvNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이미지를 업로드한 뒤에도 자유롭게 수정할 수 있어요."
                android:textColor="#999999"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
