<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: 빈틈 매칭/ChatListItem (27:1890) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/chatAvatarPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.BinTime.Circle" />

        <TextView
            android:id="@+id/chatAvatarInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_subtle"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.BinTime.CaptionBold"
            android:textColor="@color/action_primary"
            android:visibility="gone"
            tools:text="준호" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BinTime.H3"
                tools:text="김지민" />

            <TextView
                android:id="@+id/chatRoomTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.BinTime.Caption"
                android:textColor="@color/text_tertiary"
                tools:text="오후 2:32" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatRoomPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BinTime.BodyM"
                android:textColor="@color/text_secondary"
                tools:text="오늘도 좋은 하루!" />

            <TextView
                android:id="@+id/chatRoomUnread"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_primary"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textAppearance="@style/TextAppearance.BinTime.CaptionBold"
                android:textColor="@color/bg_card"
                android:visibility="gone"
                tools:text="12"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
