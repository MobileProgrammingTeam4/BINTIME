<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
        <ImageButton android:id="@+id/notificationBack" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_chevron_left" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/request_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/notification_settings" android:textAppearance="@style/TextAppearance.BinTime.H1"/>
    </LinearLayout>
    <com.team4.bintime.common.MouseWheelScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notification_settings_title" android:textAppearance="@style/TextAppearance.BinTime.H1"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/notification_settings_message" android:textAppearance="@style/TextAppearance.BinTime.BodyM" android:textColor="@color/text_secondary"/>
            <LinearLayout android:id="@+id/settingRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </LinearLayout>
    </com.team4.bintime.common.MouseWheelScrollView>
</LinearLayout>
