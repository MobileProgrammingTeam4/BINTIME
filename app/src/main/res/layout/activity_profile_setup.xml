<?xml version="1.0" encoding="utf-8"?>
<!-- 프로필 생성·수정 (Figma 41:10218, 102:2684). 수치는 Figma MCP get_design_context 값 그대로.
     상태바·홈 인디케이터 영역은 SystemBarInsets 가 대체 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:fitsSystemWindows="true">

    <!-- AppHeader Type=Back: h56 px20 gap12 -->
    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/profile_header_title"
            android:textAppearance="@style/TextAppearance.BinTime.H1" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAppBar">

        <!-- 본문: pt20 pb24 px20, 섹션 간격 16 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- 프로필 사진: Avatar 80 (흰 배경 + 1dp 테두리) + 카메라 배지 26, 간격 8, Body S 13 #666 -->
            <FrameLayout
                android:id="@+id/layoutPhotoContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/profile_add_photo">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgProfilePhoto"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:importantForAccessibility="no"
                    android:padding="0.5dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_profile_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.BinTime.Circle"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_profile_camera_badge"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_profile_camera" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPhotoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/profile_add_photo"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 기본 정보 (항목 간격 12) ─ 닉네임 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etNickname"
                android:text="@string/profile_nickname_label"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:lineHeight="16dp" />

            <EditText
                android:id="@+id/etNickname"
                style="@style/Widget.BinTime.ProfileInput"
                android:layout_marginTop="8dp"
                android:autofillHints="nickname"
                android:hint="@string/profile_nickname_hint"
                android:maxLength="10" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvNicknameError"
                    style="@style/Widget.BinTime.ProfileError"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginTop="0dp"
                    android:text="@string/profile_error_nickname_required" />

                <TextView
                    android:id="@+id/tvNicknameCount"
                    style="@style/Widget.BinTime.ProfileCaption"
                    android:layout_gravity="end|center_vertical"
                    android:text="0/10" />
            </FrameLayout>

            <!-- 학과 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_department_label"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:lineHeight="16dp" />

            <!-- 학과: 직접 입력하지 않고 학과 검색 화면(Figma 116:2685)에서 선택 -->
            <TextView
                android:id="@+id/tvDepartment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:freezesText="true"
                android:gravity="center_vertical"
                android:hint="@string/profile_department_placeholder"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDepartmentError"
                style="@style/Widget.BinTime.ProfileError"
                android:text="@string/profile_error_department_required" />

            <!-- 성별 · 학년 (열 간격 12) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGenderLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_gender_label"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:lineHeight="16dp" />

                    <FrameLayout
                        android:id="@+id/layoutGenderField"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field">

                        <Spinner
                            android:id="@+id/spinnerGender"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null" />

                        <ImageView
                            android:id="@+id/imgGenderChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_down" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_grade_label"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:lineHeight="16dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field">

                        <Spinner
                            android:id="@+id/spinnerGrade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_down" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvGenderNotice"
                style="@style/Widget.BinTime.ProfileCaption"
                android:layout_marginTop="12dp"
                android:text="@string/profile_gender_notice" />

            <!-- 자기소개 섹션 (간격 8) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/etBio"
                    android:text="@string/profile_bio_label"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:lineHeight="16dp" />

                <!-- AI 자기소개 생성 버튼: h28 px10 py4 gap4, action/soft 테두리, Caption 12 Medium -->
                <TextView
                    android:id="@+id/btnAiBio"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_pill_outline_soft"
                    android:drawablePadding="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="@string/profile_ai_write_button"
                    android:textColor="@color/action_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_sparkles" />
            </LinearLayout>

            <!-- Field: py12 px16, Body M 14 (Figma 2줄 + 빈 줄 3 = 5줄 높이) -->
            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="@string/profile_bio_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="150"
                android:minLines="5"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBioCount"
                style="@style/Widget.BinTime.ProfileCaption"
                android:layout_marginTop="8dp"
                android:text="0/150" />

            <!-- AI 추천 자기소개 카드: action/subtle, radius16, p12, sparkles 12 + Caption 12 Medium #E83D3D.
                 'AI로 작성하기'를 누른 뒤에만 표시 -->
            <TextView
                android:id="@+id/tvAiFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_ai_card"
                android:drawablePadding="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="@string/profile_ai_feedback"
                android:textColor="@color/action_pressed"
                android:textSize="12sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_sparkles" />

            <!-- 활동 선택 (간격 10) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/profile_tags_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Widget.BinTime.ProfileCaption"
                android:layout_marginTop="2dp"
                android:text="@string/profile_tags_subtitle" />

            <!-- BT-029: AI 추천 태그가 있거나, 기본 목록에 없는 태그를 골랐을 때만 표시 -->
            <TextView
                android:id="@+id/tvAiTagsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="@string/profile_ai_tags_section"
                android:textColor="@color/action_primary"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_sparkles"
                app:lineHeight="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAiTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <TextView
                style="@style/Widget.BinTime.ProfileCaption"
                android:layout_marginTop="10dp"
                android:text="@string/profile_default_tags_section" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDefaultTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 주요 액션: pt16 pb12 px20, Button Primary h52 (시작하기 / 변경하기) -->
    <FrameLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnSubmit"
            style="@style/Widget.BinTime.PillPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/profile_start_button" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
