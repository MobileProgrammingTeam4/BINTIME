<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_handle_bar" />

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.BinTime.H1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="104dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/npAmPm"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:contentDescription="오전 또는 오후" />

        <NumberPicker
            android:id="@+id/npHour"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="시" />

        <NumberPicker
            android:id="@+id/npMinute"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="분" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelTime"
            style="@style/Widget.BinTime.ButtonOutline"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="취소" />

        <TextView
            android:id="@+id/btnConfirmTime"
            style="@style/Widget.BinTime.ButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="선택" />
    </LinearLayout>
</LinearLayout>
