<?xml version="1.0" encoding="utf-8"?>
<!-- 마이 탭 (Figma 41:24577). 수치는 Figma MCP get_design_context 값 그대로.
     상태바·하단 탭 여백은 MainActivity(fitsSystemWindows)가 처리한다 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:orientation="vertical"
    tools:ignore="UseCompoundDrawables">

    <!-- AppHeader Type=Title: h56 px20, H1 20 Bold -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:text="@string/my_header_title"
        android:textAppearance="@style/TextAppearance.BinTime.H1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- 본문: px20 pb24, 섹션 간격 24 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- 정보 카드: 1dp 테두리, radius16, p16, 간격 16 -->
            <LinearLayout
                android:id="@+id/cardProfileSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar 56 -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgMyPhoto"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/my_menu_edit_profile"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_profile_placeholder"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.BinTime.Circle" />

                    <!-- 기본 정보: H3 14 Bold / 간격 4 / Body S 13 #666 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMyName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMyInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 자기소개: Body M 14 #666 -->
                <TextView
                    android:id="@+id/tvMyBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- 선호 활동: Chip Interest/Selected, 간격 8 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMyTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />
            </LinearLayout>

            <!-- 개인 설정: SectionHeader / 간격 8 / 목록(1dp 테두리 radius16) -->
            <TextView
                style="@style/Widget.BinTime.MySectionTitle"
                android:layout_marginTop="24dp"
                android:text="@string/my_section_personal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/menuEditProfile"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_user" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_edit_profile" />

                    <ImageView style="@style/Widget.BinTime.MyMenuChevron" />
                </LinearLayout>

                <View style="@style/Widget.BinTime.MyMenuDivider" />

                <LinearLayout
                    android:id="@+id/menuBlockedUsers"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_user" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_blocked_users" />

                    <ImageView style="@style/Widget.BinTime.MyMenuChevron" />
                </LinearLayout>

                <View style="@style/Widget.BinTime.MyMenuDivider" />

                <LinearLayout
                    android:id="@+id/menuTimetable"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_timetable" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_timetable" />

                    <ImageView style="@style/Widget.BinTime.MyMenuChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- 계정 설정 -->
            <TextView
                style="@style/Widget.BinTime.MySectionTitle"
                android:layout_marginTop="24dp"
                android:text="@string/my_section_account" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/menuNotification"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_bell" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_notification" />

                    <ImageView style="@style/Widget.BinTime.MyMenuChevron" />
                </LinearLayout>

                <View style="@style/Widget.BinTime.MyMenuDivider" />

                <LinearLayout
                    android:id="@+id/menuTerms"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_terms" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_terms" />

                    <ImageView style="@style/Widget.BinTime.MyMenuChevron" />
                </LinearLayout>

                <View style="@style/Widget.BinTime.MyMenuDivider" />

                <!-- SettingsRow Type=Danger: 화살표 없음, action/primary -->
                <LinearLayout
                    android:id="@+id/menuLogout"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_logout" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_logout"
                        android:textColor="@color/action_primary" />
                </LinearLayout>

                <View style="@style/Widget.BinTime.MyMenuDivider" />

                <LinearLayout
                    android:id="@+id/menuDeleteAccount"
                    style="@style/Widget.BinTime.MyMenuRow">

                    <ImageView
                        style="@style/Widget.BinTime.MyMenuIcon"
                        android:src="@drawable/ic_my_delete" />

                    <TextView
                        style="@style/Widget.BinTime.MyMenuText"
                        android:text="@string/my_menu_delete_account"
                        android:textColor="@color/action_primary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
