<?xml version="1.0" encoding="utf-8"?>
<!-- 학생 인증 (Figma 100:1411, 235:1961, 268:1969, 268:2004, 268:2039).
     수치는 Figma MCP get_design_context 값 그대로. 상태바·홈 인디케이터 영역은 SystemBarInsets 가 대체 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emailAuthRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:fitsSystemWindows="true">

    <!-- AppHeader Type=Back: h56 px20 gap12, 뒤로 40dp(아이콘 24), 제목 H1 20 Bold -->
    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/auth_header_title"
            android:textAppearance="@style/TextAppearance.BinTime.H1" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAppBar">

        <!-- 본문: py24 px20, 간격 16 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <!-- 안내문구: H1 20 Bold / Body M 14 #666, 간격 8 -->
            <TextView
                android:id="@+id/tvMainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_email_input_title"
                android:textAppearance="@style/TextAppearance.BinTime.H1" />

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_email_input_subtitle"
                android:textAppearance="@style/TextAppearance.BinTime.BodyM"
                android:textColor="@color/text_secondary" />

            <!-- InputField: 라벨 Caption 12 / 간격 8 / Field h48 radius16 px16, 글자 14 -->
            <LinearLayout
                android:id="@+id/layoutEmailInputSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/etEmail"
                    android:text="@string/auth_email_label"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:lineHeight="16dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/auth_email_hint"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvEmailHelper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auth_error_invalid_domain"
                    android:textColor="@color/action_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:lineHeight="16dp" />
            </LinearLayout>

            <!-- 목업 시연 전용 (Figma에 없는 영역). 실제 메일 링크 복귀는 BT-014에서 연결 -->
            <LinearLayout
                android:id="@+id/layoutSentInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnSimulateLinkClick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/auth_simulate_link_click"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSimulateExpired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="@string/auth_simulate_expired"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnSimulateInvalid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="@string/auth_simulate_invalid"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnSimulateOtherDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="@string/auth_simulate_other_device"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 주요 액션: pt16 pb12 px20, 보조 문구 Body M 14 #666 가운데 / 간격 8 / 버튼 h52 -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 이메일 다시 입력하기 / 다른 이메일 주소로 인증할래요 -->
        <TextView
            android:id="@+id/tvSecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/auth_reenter_email"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 인증링크 발송(Primary/Disabled) / 인증 링크 다시 보내기(Secondary) / 인증 완료하기(Primary) -->
        <TextView
            android:id="@+id/btnPrimaryAction"
            style="@style/Widget.BinTime.PillPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_disabled"
            android:enabled="false"
            android:text="@string/auth_send_link_button"
            android:textColor="@color/form_text_disabled" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
