<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
    android:orientation="vertical" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/appointmentDate" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textAppearance="@style/TextAppearance.BinTime.Caption" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/appointmentStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.BinTime.CaptionBold" android:textColor="@color/action_pressed" />
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp"
            android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right_small" />
    </LinearLayout>
    <include android:id="@+id/appointmentTimeMatch" layout="@layout/view_time_overlap"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" />
</LinearLayout>
