<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/requestContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal">
        <TextView android:id="@+id/requestHeading" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.BinTime.H3" />
        <TextView android:id="@+id/requestCount" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:textAppearance="@style/TextAppearance.BinTime.H3" android:textColor="@color/action_primary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/requestCards" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
    <com.team4.bintime.common.StateView android:id="@+id/requestState"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/requestNotice" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_box_page"
        android:padding="16dp" android:lineSpacingExtra="8dp"
        android:textAppearance="@style/TextAppearance.BinTime.Caption" android:textColor="@color/text_secondary" />
</LinearLayout>
