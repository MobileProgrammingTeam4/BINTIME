<?xml version="1.0" encoding="utf-8"?>
<!-- BT-046 차단 목록 카드. Figma 117:1923 은 LectureReviewItem(item_lecture_review)의 카드·삭제 버튼을 그대로 쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_course_item_card"
    android:gravity="center_vertical"
    android:minHeight="69dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/blockedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BinTime.H3"
            tools:text="박준호" />

        <TextView
            android:id="@+id/blockedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.BinTime.BodyS"
            android:textColor="@color/text_secondary"
            tools:text="전자공학과 3학년 · 남성" />
    </LinearLayout>

    <TextView
        android:id="@+id/blockedUnblock"
        android:layout_width="56dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_delete_small"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/block_unblock"
        android:textAppearance="@style/TextAppearance.BinTime.ButtonL"
        android:textColor="@color/action_primary" />
</LinearLayout>
