<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 116:3693 신고하기. BT-010 목업, 실제 접수는 BT-051(B) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/reportBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/report_back"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/report_header"
            android:textAppearance="@style/TextAppearance.BinTime.H1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/reportForm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_title"
                        android:textAppearance="@style/TextAppearance.BinTime.H1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/report_subtitle"
                        android:textAppearance="@style/TextAppearance.BinTime.BodyS"
                        android:textColor="@color/text_secondary" />

                    <include
                        android:id="@+id/reportPartner"
                        layout="@layout/view_partner_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/report_reasons_title"
                        android:textAppearance="@style/TextAppearance.BinTime.CaptionBold"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:id="@+id/reportReasons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/report_detail_title"
                        android:textAppearance="@style/TextAppearance.BinTime.CaptionBold"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/reportDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card"
                        android:gravity="top|start"
                        android:hint="@string/report_detail_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minHeight="80dp"
                        android:padding="14dp"
                        android:textAppearance="@style/TextAppearance.BinTime.BodyS"
                        android:textColorHint="@color/text_tertiary" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/reportAlsoBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/report_also_block"
                    android:textAppearance="@style/TextAppearance.BinTime.Caption"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/reportSubmit"
                    style="@style/Widget.BinTime.PillPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/report_submit" />
            </LinearLayout>
        </LinearLayout>

        <com.team4.bintime.common.StateView
            android:id="@+id/reportState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
