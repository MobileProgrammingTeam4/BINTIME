<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="BIN TIME"
        android:supportsRtl="true"
        android:theme="@style/Theme.BinTime">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".matching.FilterActivity" />
        <activity android:name=".matching.ProfileDetailActivity" />
        <activity android:name=".request.MatchAcceptedActivity" android:exported="false" />
        <activity android:name=".notification.NotificationSettingsActivity" android:exported="false" />
    </application>
</manifest>
