<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="BIN TIME"
        android:supportsRtl="true"
        android:theme="@style/Theme.BinTime">

        <!-- 최초 가입: 온보딩 → 학교 이메일 인증 → 시간표 등록 → 프로필 생성 → 메인 -->
        <activity
            android:name=".auth.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />
        <activity
            android:name=".auth.EmailAuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".profile.ProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".profile.DepartmentSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".timetable.TimetableSelectModeActivity" android:exported="false" />
        <activity
            android:name=".timetable.CourseDirectInputActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".timetable.CourseModifyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".timetable.TimetableUploadActivity" android:exported="false" />
        <activity android:name=".timetable.TimetableReviewActivity" android:exported="false" />
        <activity android:name=".timetable.TimetableRegistrationActivity" android:exported="false" />
        <activity android:name=".matching.FilterActivity" />
        <activity android:name=".matching.ProfileDetailActivity" />
        <activity android:name=".request.MatchAcceptedActivity" android:exported="false" />
        <activity android:name=".notification.NotificationSettingsActivity" android:exported="false" />
        <activity
            android:name=".chat.ChatRoomActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".review.ReviewWriteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".review.ReviewDetailActivity" android:exported="false" />
        <activity
            android:name=".report.ReportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
